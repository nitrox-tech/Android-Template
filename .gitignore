# Cập nhật .gitignore sau khi thay đổi
# 1. Xóa bộ nhớ cache Git: git rm -r --cached .
# 2. Thêm lại tất cả các tệp: git add .
# 3. Commit các thay đổi: git commit -m "Cập nhật .gitignore"

## Tham khảo: https://dev.to/jafetmeza/how-to-update-your-gitignore-file-325e

# Built application files
*.apk
*.aar
*.ap_
*.aab
*.dm

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
*/build/*
output.json

# Gradle files
.gradle/
.gradle-user-home/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/
.externalNativeBuild/
.cxx/

# IntelliJ / Android Studio
*.iml
.idea/
# Nếu muốn giữ lại cấu hình chung của project thì comment dòng .idea/ ở trên và bỏ comment các dòng dưới:
# !.idea/runConfigurations/
# !.idea/copyright/
# !.idea/vcs.xml
# !.idea/modules.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
# app/google-services.json

# Android Profiling
*.hprof

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# System files
.DS_Store

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Ignore custom scripts
*.ps1
*.py
/*.ps1
/*.py